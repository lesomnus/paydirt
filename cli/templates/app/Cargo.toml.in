[package]
name = "__APP_NAME__"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["rlib", "cdylib"]

[features]
client = ["connectrpc/client"]
resource-cel=["paydirt-store/resource-cel"]

[dependencies]
base64="0.22"
async-lock = "3"
async-stream = "0.3"
futures-timer = {version="3",features=["wasm-bindgen"]}
futures-channel = "0.3"
futures-util = "0.3"
buffa = { version = "=0.8.1", features = ["json"] }
buffa-types = { version = "=0.8.1", features = ["json"] }
connectrpc = { version = "=0.8.2", default-features = false, features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
hex = "0.4"
chrono-tz="0.10"
chrono={version="0.4",features=["wasmbind"]}
paydirt = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601"}

[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
paydirt-server = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601"}
paydirt = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601",features=["watch-postgres","watch-nats"]}
paydirt-store = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601",features=["postgres","sqlite","workers"]}
connectrpc = {version="=0.8.2",default-features=false,features=["server","client-tls"]}
buffa-reflect = {version="0.9.2", default-features=false, features=["serde","text-format"]}
gtmpl = "0.7.1"
http="1"
rustls="0.23"
webpki-roots="1"
uuid="1"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "signal"] }

[target.'cfg(target_arch = "wasm32")'.dependencies]
paydirt-store = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601"}
wasm-bindgen = "=0.2.130"
js-sys = "0.3"
wasm-bindgen-futures = "0.4"
send_wrapper = {version="0.6",features=["futures"]}
drpc-rs = { git = "https://github.com/lesomnus/drpc-rs", rev = "4b8d42cbab7fe29d78eba73f9f7d2c6edd560e12" }
web-sys = { version = "0.3", features = ["MessagePort"] }
[target.'cfg(not(target_arch = "wasm32"))'.dev-dependencies]
paydirt-test = {git="https://github.com/lesomnus/paydirt",rev="d32062ef50815f681eaaee215a364bff73cd8601"}
chrono = "0.4"

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
strip = "debuginfo"
