[package]
name = "__APP_NAME__"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["rlib", "cdylib"]

[features]
client = ["connectrpc/client"]

[dependencies]
buffa = { version = "=0.8.1", features = ["json"] }
buffa-types = { version = "=0.8.1", features = ["json"] }
connectrpc = { version = "=0.8.2", default-features = false, features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
hex = "0.4"
paydirt = {git="https://github.com/lesomnus/paydirt",rev="72f32aef0e4210d0f9e99b9d0636f188dff5a638"}

[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
paydirt-store = {git="https://github.com/lesomnus/paydirt",rev="72f32aef0e4210d0f9e99b9d0636f188dff5a638",features=["postgres","sqlite"]}
connectrpc = {version="=0.8.2",default-features=false,features=["server"]}
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }

[target.'cfg(target_arch = "wasm32")'.dependencies]
paydirt-store = {git="https://github.com/lesomnus/paydirt",rev="72f32aef0e4210d0f9e99b9d0636f188dff5a638"}
wasm-bindgen = "=0.2.130"
js-sys = "0.3"
wasm-bindgen-futures = "0.4"
send_wrapper = {version="0.6",features=["futures"]}
drpc-rs = { git = "https://github.com/lesomnus/drpc-rs", rev = "2e9d63e2c21a908b88c3569c9c8d785b3b33893c" }
web-sys = { version = "0.3", features = ["MessagePort"] }
[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
strip = "debuginfo"
